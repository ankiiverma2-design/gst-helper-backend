{
  "name": "gst-helper-backend",
  "version": "0.1.0",
  "description": "GST filing & reconciliation helper for small Indian sellers - backend API (zero-dependency, Node built-ins only)",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --experimental-sqlite src/server.ts",
    "dev": "node --watch --experimental-strip-types --experimental-sqlite src/server.ts",
    "test": "node --experimental-strip-types --experimental-sqlite --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["gst", "reconciliation", "gstr-2b", "gstr-1", "gstr-3b", "india", "itc"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
